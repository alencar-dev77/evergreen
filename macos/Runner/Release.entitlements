<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- O App Sandbox fica desligado de propósito.
	     Um gerenciador de área de transferência precisa registrar atalho global
	     no sistema e escrever o LaunchAgent de "iniciar com o macOS" — ambos
	     bloqueados dentro do sandbox. O Evergreen é distribuído fora da App
	     Store. A única conexão que ele abre é o download, uma vez, do modelo
	     que separa as vozes do Echo; nada da máquina é enviado. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Com o runtime endurecido, que a notarização exige, o microfone é
	     negado em silêncio a quem não declara este. É a voz de quem usa no
	     Echo. A captura do áudio do computador (ScreenCaptureKit), o
	     auto-colar do Pin (Acessibilidade) e o arraste do Nest não pedem
	     entitlement nenhum: são permissões do sistema, não do runtime. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
