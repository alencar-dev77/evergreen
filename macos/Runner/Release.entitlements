<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- O App Sandbox fica desligado de propósito.
	     Um gerenciador de área de transferência precisa registrar atalho global
	     no sistema e escrever o LaunchAgent de "iniciar com o macOS" — ambos
	     bloqueados dentro do sandbox. O Evergreen é distribuído fora da App
	     Store. Para fora da máquina ele abre duas conexões: o download, uma
	     vez, do modelo que separa as vozes do Echo, e a procura por versão
	     nova do Sparkle (o appcast.xml no GitHub); nada da máquina é enviado.
	     A outra é local: o servidor do LM Studio em 127.0.0.1:1234, quando a
	     pessoa o escolhe como modelo local. Sem sandbox, nenhuma delas pede
	     entitlement de rede. A lista inteira está na PRIVACY.md. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Com o runtime endurecido, que a notarização exige, o microfone é
	     negado em silêncio a quem não declara este. É a voz de quem usa no
	     Echo. A captura do áudio do computador (ScreenCaptureKit), o
	     auto-colar do Pin (Acessibilidade) e o arraste do Nest não pedem
	     entitlement nenhum: são permissões do sistema, não do runtime. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
