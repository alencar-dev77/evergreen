#!/usr/bin/env bash
#
# bump_version — bump manual da versão, a rede de segurança pra quando o CI
# está fora do ar.
#
# Normalmente ninguém roda isto à mão: quem bumpa o semver é o
# `.github/workflows/version-bump.yml`, no merge de uma PR na `validation`,
# lendo a label `bump:` da própria PR, e quem sobe o build é o botão "Preparar
# release" (`preparar-release.yml`). Os dois chamam este script — é a mesma
# regra, num lugar só. Mas os dois dependem do GitHub Actions estar rodando, e
# quando o Actions para (billing, incidente, greve de runner) o merge acontece e
# o bump não — a versão congela em silêncio.
#
# Aqui isso custa mais caro do que parece. O `version:` do `pubspec.yaml` é o que
# a barra lateral do Hub mostra no rodapé (via `AppInfo`/`package_info_plus`), e
# o Evergreen é instalado pelo `./scripts/run_build_copy`, que copia por cima da cópia
# em /Applications. Com a versão congelada, duas instalações diferentes se
# apresentam com o mesmo número e não há como dizer qual está na máquina — que é
# justamente a pergunta que se faz quando algo quebrou depois de uma instalação.
#
# Este script faz **exatamente** o que o workflow faria, do mesmo lugar: na
# `validation`, DEPOIS do merge. A `validation` é a branch de integração — é
# para ela que vão as PRs de feature, é nela que a label é exigida
# (`require-bump-label.yml`) e é nela que a versão sobe. A `main` herda o número
# pela PR de promoção, que não bumpa nada.
#
# Não rode na branch da feature — o bump é ato de integração, não de feature:
#   - duas PRs abertas ao mesmo tempo bumpariam as duas pro mesmo número e
#     conflitariam no `pubspec.yaml`;
#   - a versão seria decidida antes de se saber se a PR entra.
#
# São DOIS bumps, com gatilhos diferentes, e misturá-los é o erro fácil:
#
#   SEMVER (X.Y.Z) — sobe a cada PR mergeada na `validation`, pela label
#   `bump:patch|minor|major`. Responde "que conjunto de mudanças é este", e é o
#   que o rodapé do Hub mostra. NÃO mexe no build.
#
#   BUILD (+N) — sobe UMA vez por release, antes de promover para a `main`.
#   Responde "qual publicação é esta": é o `CFBundleVersion` do `.dmg` que o
#   `./scripts/release` gera, e o que separa duas publicações do mesmo semver (uma
#   correção do instalador, um `.dmg` refeito). NÃO mexe no semver. Antes, o
#   `cider bump <nível>` do workflow zerava o build a cada semver, e por isso
#   todo o histórico até a 0.33.0 é `+1` — um número que não distinguia nada.
#
# O build não sobe por PR de propósito: entre duas publicações cabem várias PRs,
# e o número passaria a contar merges em vez de releases. E não sobe na promoção
# porque o commit nasceria na `main`, que então divergiria da `validation`.
#
# Uso:
#   ./scripts/bump_version                 # nível vem das PRs pendentes (label bump:*)
#   ./scripts/bump_version patch           # nível explícito (patch|minor|major)
#   ./scripts/bump_version --pr 29         # nível vem da label daquela PR
#   ./scripts/bump_version --build         # +1 no build, semver intacto (preparar release)
#   ./scripts/bump_version patch --nota "Texto (#12)"   # a linha do CHANGELOG.md
#   ./scripts/bump_version --dry-run       # só mostra o que faria
#   ./scripts/bump_version --push          # commita, tagueia E envia (padrão: não envia)
#
# O bump de semver também escreve o CHANGELOG.md, no mesmo commit: uma seção
# com a versão nova e uma linha por PR, o título dela. É o texto que quem usa o
# app lê (o `./scripts/release` o põe nas notas do GitHub Release), e por isso
# o título da PR é escrito para essa pessoa — a regra está no AGENTS.md. O
# prefixo de commit (`feat:`, `fix(echo):`) sai sozinho, para o caso de ele
# escapar. De onde vem a linha: `--nota`, o título da `--pr`, ou os títulos das
# PRs pendentes. O `--build` não escreve nada: a publicação não é novidade.
#
# O padrão é NÃO enviar: o script deixa commit e tag prontos e imprime os dois
# `git push`, pra você conferir antes.
#
set -euo pipefail

BRANCH_BUMP="validation"

# Os scripts moram em `scripts/`; tudo daqui para baixo roda da raiz.
cd "$(dirname "$0")/.."

vermelho() { printf '\033[31m%s\033[0m\n' "$*" >&2; }
verde()    { printf '\033[32m%s\033[0m\n' "$*"; }
azul()     { printf '\033[34m%s\033[0m\n' "$*"; }
amarelo()  { printf '\033[33m%s\033[0m\n' "$*"; }

erro() { vermelho "❌ $*"; exit 1; }

# --- Argumentos -------------------------------------------------------------
NIVEL=""
PR_ALVO=""
DRY_RUN=false
PUSH=false
MODO_BUILD=false
NOTAS=""
NL=$'\n'

while [ $# -gt 0 ]; do
  case "$1" in
    patch|minor|major) NIVEL="$1"; shift ;;
    --pr)              PR_ALVO="${2:-}"; [ -n "$PR_ALVO" ] || erro "--pr exige o número da PR."; shift 2 ;;
    --build)           MODO_BUILD=true; shift ;;
    --nota)            [ -n "${2:-}" ] || erro "--nota exige o texto."
                       NOTAS="${NOTAS:+$NOTAS$NL}$2"; shift 2 ;;
    --dry-run)         DRY_RUN=true; shift ;;
    --push)            PUSH=true; shift ;;
    -h|--help)         awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *)                 erro "Argumento desconhecido: $1 (use --help)" ;;
  esac
done

if [ "$MODO_BUILD" = true ] && { [ -n "$NIVEL" ] || [ -n "$PR_ALVO" ] || [ -n "$NOTAS" ]; }; then
  erro "--build sobe só o build number; não combine com nível, --pr nem --nota."
fi

# --- Guardas ----------------------------------------------------------------
branch_atual="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch_atual" != "$BRANCH_BUMP" ]; then
  erro "O bump é feito na '$BRANCH_BUMP', depois do merge (você está em '$branch_atual'). Veja o cabeçalho do script."
fi
verde "✓ Branch: $branch_atual"

if [ -n "$(git status --porcelain)" ]; then
  git status --short >&2
  erro "Há alterações não commitadas. O bump precisa entrar num commit só dele."
fi
verde "✓ Sem alterações pendentes"

azul "→ git fetch origin $BRANCH_BUMP"
git fetch --quiet origin "$BRANCH_BUMP"

local_sha="$(git rev-parse HEAD)"
remoto_sha="$(git rev-parse "origin/$BRANCH_BUMP")"
base_sha="$(git merge-base HEAD "origin/$BRANCH_BUMP")"

if [ "$local_sha" != "$remoto_sha" ]; then
  if [ "$local_sha" = "$base_sha" ]; then
    erro "Branch atrasada em relação a origin/$BRANCH_BUMP. Rode 'git pull' antes de bumpar."
  elif [ "$remoto_sha" = "$base_sha" ]; then
    erro "Há commits locais que não foram enviados. Rode 'git push' antes de bumpar."
  else
    erro "Branch divergiu de origin/$BRANCH_BUMP. Resolva antes de bumpar."
  fi
fi
verde "✓ Em dia com origin/$BRANCH_BUMP ($(git rev-parse --short HEAD))"

# --- Nível do bump ----------------------------------------------------------
# Mesma precedência do workflow: major > minor > patch.
nivel_das_labels() {
  local labels="$1"
  if   echo "$labels" | grep -q "bump:major"; then echo "major"
  elif echo "$labels" | grep -q "bump:minor"; then echo "minor"
  elif echo "$labels" | grep -q "bump:patch"; then echo "patch"
  else echo ""
  fi
}

if [ "$MODO_BUILD" = false ] && [ -n "$PR_ALVO" ]; then
  command -v gh >/dev/null || erro "--pr precisa do 'gh' instalado."
  labels="$(gh pr view "$PR_ALVO" --json labels -q '[.labels[].name] | join(" ")')"
  NIVEL="$(nivel_das_labels "$labels")"
  if [ -z "$NOTAS" ]; then
    NOTAS="$(gh pr view "$PR_ALVO" --json title -q .title) (#$PR_ALVO)"
  fi
  [ -n "$NIVEL" ] || erro "A PR #$PR_ALVO não tem label bump:patch/minor/major."
  azul "→ PR #$PR_ALVO: label bump:$NIVEL"
fi

if [ "$MODO_BUILD" = false ] && [ -z "$NIVEL" ]; then
  # Sem nível explícito: descobre o que foi mergeado na validation desde o
  # último commit de bump — que é justamente o que o CI deixou de processar.
  command -v gh >/dev/null || erro "Sem 'gh' instalado, informe o nível: ./scripts/bump_version patch"

  ultimo_bump="$(git log -1 --format='%cI' --grep='^chore: bump version to' "origin/$BRANCH_BUMP" || true)"
  [ -n "$ultimo_bump" ] || erro "Não achei o último commit de bump. Informe o nível na mão."
  azul "→ Último bump: $ultimo_bump"

  pendentes="$(gh pr list --state merged --base "$BRANCH_BUMP" --limit 30 \
    --json number,title,mergedAt,labels \
    -q "[.[] | select(.mergedAt > \"$ultimo_bump\")] | .[] | \"\(.number)\t\([.labels[].name] | join(\",\"))\t\(.title)\"" || true)"

  if [ -z "$pendentes" ]; then
    amarelo "Nenhuma PR mergeada na $BRANCH_BUMP depois do último bump — nada a fazer."
    exit 0
  fi

  echo
  azul "PRs mergeadas sem bump:"
  printf '%s\n' "$pendentes" | while IFS=$'\t' read -r num lbl tit; do
    printf '  #%-5s %-12s %s\n' "$num" "${lbl:-sem label}" "$tit"
  done
  echo

  NIVEL="$(nivel_das_labels "$(printf '%s' "$pendentes" | cut -f2 | tr '\n' ' ')")"
  if [ -z "$NOTAS" ]; then
    NOTAS="$(printf '%s\n' "$pendentes" | awk -F'\t' '{ print $3 " (#" $1 ")" }')"
  fi
  [ -n "$NIVEL" ] || erro "Nenhuma das PRs pendentes tem label bump:*. Informe o nível na mão."

  # Um bump só pra todas as pendentes, com o nível mais forte entre elas: as
  # tags marcam o que está publicável, e não há Release por feature pra
  # justificar um número por PR (nem commit onde pendurar os intermediários).
  amarelo "→ Um bump '$NIVEL' cobrindo as PRs acima (a mais forte manda)."
fi

# No Actions, sem --nota: o título vem do evento da própria PR. É o script que
# vai buscá-lo, e não só o workflow que o passa, porque o `pull_request_target`
# roda o workflow da `main` — que fica um passo atrás até a promoção —, mas
# este script sai do checkout da `validation`. Um workflow velho que não sabe
# do `--nota` deixava a versão sem linha no CHANGELOG (foi o que aconteceu na
# 1.0.0). O título é lido pelo `jq` como texto e nunca é executado.
if [ "$MODO_BUILD" = false ] && [ -z "$NOTAS" ] && [ -n "${GITHUB_EVENT_PATH:-}" ] \
  && command -v jq >/dev/null; then
  NOTAS="$(jq -r 'if .pull_request.title then "\(.pull_request.title) (#\(.pull_request.number))" else empty end' \
    "$GITHUB_EVENT_PATH" 2>/dev/null || true)"
fi

# --- Cálculo da nova versão -------------------------------------------------
# Os dois bumps são exclusivos: o de nível preserva o build, o --build preserva
# o semver (ver o cabeçalho).
atual="$(grep -m1 '^version:' pubspec.yaml | awk '{print $2}')"
[ -n "$atual" ] || erro "Não consegui ler 'version:' do pubspec.yaml."

semver="${atual%%+*}"
case "$atual" in
  *+*) build="${atual##*+}" ;;
  *)   build=0 ;;
esac
case "$build" in
  *[!0-9]*|"") erro "Build number em formato inesperado no pubspec.yaml: $atual" ;;
esac

IFS='.' read -r MAJOR MINOR PATCH <<< "$semver"
case "$MAJOR$MINOR$PATCH" in
  *[!0-9]*|"") erro "Versão em formato inesperado no pubspec.yaml: $atual" ;;
esac

if [ "$MODO_BUILD" = true ]; then
  build=$((build + 1))
  descricao="build +1 (preparar release)"
else
  case "$NIVEL" in
    major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
    minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
    patch) PATCH=$((PATCH + 1)) ;;
  esac
  descricao="bump $NIVEL (build intacto em +$build)"
fi

nova="$MAJOR.$MINOR.$PATCH+$build"
tag="v$nova"

echo
azul "→ $atual  ->  $nova   ($descricao)"
azul "→ tag: $tag"

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  erro "A tag $tag já existe. Alguém já bumpou pra essa versão."
fi

if [ "$DRY_RUN" = true ]; then
  echo
  amarelo "--dry-run: nada foi alterado."
  exit 0
fi

# --- Aplica -----------------------------------------------------------------
tmp="$(mktemp)"
sed "s|^version: .*|version: $nova|" pubspec.yaml > "$tmp"
mv "$tmp" pubspec.yaml

# Uma linha do CHANGELOG.md por nota: sem o prefixo de commit e com a primeira
# letra maiúscula. Em Perl, e não no `${x^}` do bash: o bash do macOS é o 3.2,
# que não tem, e o `\u` do Perl sabe que "é" vira "É".
linhas_do_changelog() {
  printf '%s\n' "$1" \
    | perl -CSD -ne 's/^\s+|\s+$//g; s/^[a-z]+(\([^)]*\))?!?:\s*//; next unless length; print "- \u$_\n"'
}

if [ "$MODO_BUILD" = false ]; then
  marca="<!-- novidades: o bump_version escreve abaixo desta linha -->"
  grep -qF "$marca" CHANGELOG.md || erro "CHANGELOG.md sem a linha '$marca'."

  if [ -z "$NOTAS" ]; then
    amarelo "⚠️  Sem --nota: a $MAJOR.$MINOR.$PATCH entra no CHANGELOG.md sem linha."
  fi

  secao="$(mktemp)"
  {
    printf '## %s — %s\n' "$MAJOR.$MINOR.$PATCH" "$(date +%d/%m/%Y)"
    [ -z "$NOTAS" ] || { echo; linhas_do_changelog "$NOTAS"; }
  } > "$secao"

  tmp="$(mktemp)"
  awk -v marca="$marca" -v secao="$secao" '
    { print }
    $0 == marca { print ""; while ((getline linha < secao) > 0) print linha }
  ' CHANGELOG.md > "$tmp"
  mv "$tmp" CHANGELOG.md
  rm -f "$secao"
  git add CHANGELOG.md
fi

git add pubspec.yaml
git commit --quiet -m "chore: bump version to $nova"
git tag "$tag"

echo
verde "✓ Commit e tag criados localmente"

if [ "$PUSH" = true ]; then
  azul "→ git push origin $BRANCH_BUMP && git push origin $tag"
  git push --quiet origin "$BRANCH_BUMP"
  git push --quiet origin "$tag"
  verde "✅ $nova enviada pra origin/$BRANCH_BUMP"
else
  echo
  amarelo "Nada foi enviado ainda. Confira com 'git show HEAD' e envie:"
  echo "  git push origin $BRANCH_BUMP"
  echo "  git push origin $tag"
fi

echo
if [ "$MODO_BUILD" = true ]; then
  azul "Depois: abra a PR $BRANCH_BUMP -> main. O portão 'check-build-bump'"
  azul "confere que o build cresceu; promovida, o ./scripts/release publica a $nova."
else
  azul "Depois: siga integrando. Na hora de promover, rode --build (ou o botão"
  azul "'Preparar release' na aba Actions) e abra a PR $BRANCH_BUMP -> main."
fi
